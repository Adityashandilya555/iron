# IronClaw Production Environment - Multi-Tenant Configuration
# Copy this file to .env.production and replace all CHANGE_ME values

# ============================================================================
# DATABASE (PostgreSQL with pgvector)
# ============================================================================
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ============================================================================
# MULTI-TENANT CONFIGURATION (CRITICAL)
# ============================================================================

# Enable multi-tenant mode - MUST be true for multi-user deployment
AGENT_MULTI_TENANT=true

# Per-user concurrency limits (prevents one user from monopolizing resources)
# Each user gets their own semaphore pool
TENANT_MAX_LLM_CONCURRENT=4      # Max concurrent LLM calls per user
TENANT_MAX_JOBS_CONCURRENT=2      # Max concurrent jobs per user

# Global limits across all users
AGENT_MAX_PARALLEL_JOBS=20        # Total concurrent jobs across all users

# Per-user daily cost limits (in cents)
# 1000 cents = $10/day per user (adjust based on your pricing)
MAX_COST_PER_USER_PER_DAY_CENTS=1000

# Global daily cost limit (in cents)
# 50000 cents = $500/day total across all users
MAX_COST_PER_DAY_CENTS=50000

# ============================================================================
# SESSION MANAGEMENT
# ============================================================================
SESSION_IDLE_TIMEOUT_SECS=3600   # 1 hour idle timeout
DEFAULT_TIMEZONE=UTC

# ============================================================================
# AUTHENTICATION
# ============================================================================

# Single token mode (for personal use)
AUTH_MODE=single
GATEWAY_AUTH_TOKEN=CHANGE_ME_TO_SECURE_RANDOM_TOKEN

# Multi-user mode (uncomment and configure for multiple users)
# AUTH_MODE=multi
# AUTH_TOKENS=tok-admin:admin:admin,tok-alice:alice:member,tok-bob:bob:member

# For Telegram/Discord OAuth, see docs/AUTH_SETUP.md

# ============================================================================
# GATEWAY
# ============================================================================
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3000
GATEWAY_ENABLED=true

# Rate limiting (per-IP for unauthenticated, per-user for authenticated)
CHAT_RATE_LIMIT_PER_MINUTE=30

# ============================================================================
# LLM PROVIDER (Choose one)
# ============================================================================

# Option 1: OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-CHANGE_ME
# OPENAI_MODEL=gpt-4o

# Option 2: Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Option 3: NEAR AI
# LLM_PROVIDER=nearai
# NEARAI_API_KEY=CHANGE_ME
# NEARAI_MODEL=claude-3-5-sonnet-20241022
# NEARAI_BASE_URL=https://cloud-api.near.ai

# ============================================================================
# FEATURES (Enable as needed)
# ============================================================================

# Sandbox for code execution (requires Docker-in-Docker or volume mount)
SANDBOX_ENABLED=false

# Heartbeat for proactive agent messages
HEARTBEAT_ENABLED=false

# Embeddings for semantic search
EMBEDDING_ENABLED=false

# Tool approvals - set to true to skip approval prompts
AGENT_AUTO_APPROVE_TOOLS=false

# Planning before tool execution
AGENT_USE_PLANNING=true

# ============================================================================
# TELEGRAM CHANNEL (Uncomment to enable)
# ============================================================================
# TELEGRAM_BOT_TOKEN=CHANGE_ME_BOT_TOKEN
# TELEGRAM_OWNER_ID=123456789  # Your Telegram user ID (optional, restricts to owner only)

# ============================================================================
# DISCORD CHANNEL (Uncomment to enable)
# ============================================================================
# DISCORD_BOT_TOKEN=CHANGE_ME_BOT_TOKEN

# ============================================================================
# LOGGING
# ============================================================================
RUST_LOG=ironclaw=info,tower_http=info

# ============================================================================
# DOCKER SETTINGS
# ============================================================================
IRONCLAW_IN_DOCKER=true
IRONCLAW_RESTART_DELAY=5
IRONCLAW_MAX_FAILURES=10

# ============================================================================
# MEMORY (per-user limit)
# ============================================================================
AGENT_MAX_TOKENS_PER_JOB=500000  # Max tokens per conversation turn